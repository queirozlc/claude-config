# Whitelist. Repo root is $HOME. Everything is ignored unless listed below.
# Never tracked: sessions, transcripts, memories, history, caches, credentials, backups, ship state.
*
!.gitignore
!README.md
!PROMPT.md

# ~/.claude
!.claude/
.claude/*
!.claude/install.sh
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/statusline.sh
!.claude/agents/
!.claude/agents/**
!.claude/hooks/
!.claude/hooks/**
!.claude/local-marketplace/
!.claude/local-marketplace/**
!.claude/output-styles/
!.claude/output-styles/**
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**
.claude/skills/elixir
.claude/skills/dexcare-aws
.claude/skills/vpn
.claude/skills/orca-cli
.claude/skills/orca-linear
.claude/skills/orca-team
.claude/skills/orchestration
.claude/skills/synced

# ~/.agents
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**
.agents/skills/impeccable
.agents/skills/revenue-centric-design
.agents/skills/dexcare-aws
.agents/skills/orca-cli
.agents/skills/orca-linear
.agents/skills/orchestration
!.agents/ship/
.agents/ship/*
!.agents/ship/ledger-stop.py
!.agents/ship/CLAUDE.md
!.agents/ship/README.md
!.agents/ship/dispatch.py
!.agents/ship/ledger.py
!.agents/ship/floor-status-stop.py
!.agents/ship/thread-guard.py
!.agents/ship/link-local.sh
!.agents/ship/test-*.py
!.agents/ship/state/
.agents/ship/state/*
!.agents/ship/state/.gitkeep
!.agents/ship/state/_archive/
.agents/ship/state/_archive/*
!.agents/ship/state/_archive/.gitkeep

# Git setup. ~/.config is its own local repo (GitHub routing lives there), so it stays out.
!.gitignore_global
!.git-hooks/
!.git-hooks/**

.DS_Store
